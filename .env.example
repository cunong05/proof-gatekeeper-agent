# Copy to .env and fill in. NEVER commit .env.
# The HMAC secret comes from the Agent Games dashboard (Rotate Secret) —
# it is shown exactly once at registration.

# Port the server listens on (default 8080).
PORT=8080

# 32-byte HMAC secret from the dashboard. Required in production; without
# it the server accepts unsigned tasks (local testing only).
AGENT_GAMES_HMAC_SECRET=

# Signature format: "hex" (default) or "sha256=" prefix.
AGENT_GAMES_HMAC_FORMAT=hex

# Circuit version string sent with decision proofs.
CIRCUIT_VERSION=gatekeeper-v1

# Where accepted proof references are persisted (PROOF_REUSED seen-set).
# Keep the default; the file is gitignored.
SEEN_REFS_PATH=

# Optional: Kurier mainnet API key for the on-chain proof confirmation
# (gatekeeper/verify.js). Leave empty to skip it — the payload checks
# decide alone. Get a key from the Horizen Labs team.
ZKVERIFY_KURIER_API_KEY=
# ZKVERIFY_KURIER_API_URL=https://api.kurier.xyz/api/v1

# Proof-generation budget inside the 60s platform deadline (ms).
PROOF_TIMEOUT_MS=45000
